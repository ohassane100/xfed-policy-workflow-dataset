{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XFed Policy Review Schema",
  "description": "Rule entailment and whole-clause coverage review, including classifier negatives and generator abstentions.",
  "type": "object",
  "required": [
    "review_id",
    "policy_uid",
    "reviewer_id",
    "rule_reviews",
    "clause_reviews",
    "status",
    "requires_human_approval",
    "evidence_errors",
    "conflicts",
    "input_hashes",
    "prompt_sha256"
  ],
  "properties": {
    "review_id": {
      "type": "string"
    },
    "policy_uid": {
      "type": "string",
      "description": "uid of odrlPolicy being reviewed."
    },
    "reviewer_id": {
      "type": "string",
      "description": "Local company/slave node performing the independent review."
    },
    "status": {"type": "string", "enum": ["reviewed_no_issues_found", "changes_requested", "incomplete"]},
    "summary": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "requires_human_approval": {"const": true},
    "evidence_errors": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "input_hashes": {
      "type": "object",
      "required": ["policy", "enriched", "classified"],
      "properties": {"policy": {"type": "string"}, "enriched": {"type": "string"}, "classified": {"type": "string"}},
      "additionalProperties": false
    },
    "prompt_sha256": {"type": "string"},
    "clause_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chunk_id", "reviewer", "relevance", "classification_label", "classification_disagreement", "same_model_as_generator", "coverage", "reason", "missing_rules", "rule_uids"],
        "properties": {
          "chunk_id": {"type": "string"},
          "rule_uids": {"type": "array", "items": {"type": "string"}},
          "reviewer": {
            "type": "object", "required": ["model", "model_digest"],
            "properties": {"model": {"type": ["string", "null"]}, "model_digest": {"type": ["string", "null"]}},
            "additionalProperties": false
          },
          "relevance": {"enum": ["RELEVANT", "NOT_RELEVANT", "NEEDS_CONTEXT"]},
          "classification_label": {"enum": ["RELEVANT", "NOT_RELEVANT", "NEEDS_CONTEXT"]},
          "classification_disagreement": {"type": "boolean"},
          "same_model_as_generator": {"type": ["boolean", "null"]},
          "coverage": {"enum": ["COMPLETE", "MISSING_RULES", "NO_RULES_NEEDED", "NEEDS_CONTEXT"]},
          "reason": {"type": "string"},
          "missing_rules": {"type": "array", "items": {"type": "string"}},
          "missing_rule_evidence": {"type": "array", "items": {"type": "object", "required": ["requirement", "primary_quote"], "properties": {"requirement": {"type": "string"}, "primary_quote": {"type": "string"}}, "additionalProperties": false}},
          "unresolved_references": {"type": "array", "items": {"type": "string"}},
          "error": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "rule_reviews": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "rule_uid",
          "rule_type",
          "verdict"
        ],
        "properties": {
          "rule_uid": {
            "type": "string",
            "description": "uid of the ODRL rule being reviewed."
          },
          "rule_type": {
            "type": "string",
            "enum": [
              "permission",
              "prohibition",
              "obligation",
              "duty"
            ]
          },
          "verdict": {
            "type": "string",
            "enum": [
              "ENTAILED",
              "CONTRADICTED",
              "UNSUPPORTED",
              "AMBIGUOUS"
            ]
          },
          "reason": {
            "type": "string",
            "description": "Optional concise explanation of the verdict."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
